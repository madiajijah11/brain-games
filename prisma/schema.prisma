generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String                @id @default(cuid())
  name             String
  email            String                @unique
  passwordHash     String
  totalXp          Int                   @default(0)
  competitiveXp    Int                   @default(0)
  streak           Int                   @default(0)
  lastPlayedAt     DateTime?
  createdAt        DateTime              @default(now())
  gameSessions     GameSession[]
  dailyEntries     DailyEntry[]
  dailyCompletions DailyGameCompletion[]

  @@index([competitiveXp, totalXp])
}

model DailyGameCompletion {
  id          String   @id @default(cuid())
  userId      String
  gameSlug    String
  dateKey     String   // "YYYY-MM-DD" in UTC
  issueNumber Int
  timeTakenMs Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameSlug, dateKey])
  @@index([gameSlug, dateKey])
}

model GameSession {
  id          String   @id @default(cuid())
  userId      String
  gameSlug    String
  score       Int
  xpEarned    Int
  correct     Int      @default(0)
  total       Int      @default(0)
  durationMs  Int
  issueNumber Int?
  mode        String   @default("daily") // "daily" | "practice"
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gameSlug, score])
}

model DailyEntry {
  id          String   @id @default(cuid())
  userId      String
  dateKey     String
  completedAt DateTime @default(now())
  score       Int
  xpEarned    Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey, score])
}
