# Neon PostgreSQL — runtime uses the pooled URL (hostname contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon PostgreSQL — Prisma CLI migrations use the direct, unpooled URL
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-NEON-HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth.js v5: generate with `npm exec auth secret` or `openssl rand -base64 33`
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Optional locally. Auth.js v5 infers the host on Vercel.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Product currently stores daily challenge and streak dates in UTC.
